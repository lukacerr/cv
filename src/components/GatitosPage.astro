---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Badge } from '@/components/starwind/badge';
import { ThemeToggle } from '@/components/starwind/theme-toggle';
import {
	contact,
	type GatitosData,
	type GatitosLocale,
	gatitosLanguageLabels,
	gatitosLocales,
	gatitosPaths,
	litters,
} from '@/i18n/gatitos';

interface Props {
	data: GatitosData;
	lang: GatitosLocale;
}

const { data, lang } = Astro.props;

// Photos live in src/assets/gatitos/<name>-<n>.jpg (optimized by astro:assets)
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/gatitos/*.jpg',
	{ eager: true },
);
const photosOf = (slug: string) =>
	Object.entries(photoModules)
		.filter(([path]) => path.includes(`/${slug}-`))
		.sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
		.map(([, mod]) => mod.default);

type Slide =
	| { kind: 'image'; src: ImageMetadata }
	| { kind: 'gif'; src: string; width: number; height: number };

const groups = litters.map((litter) => ({
	...data.litters[litter.id],
	kittens: litter.kittens.map((kitten) => {
		const slides: Slide[] = photosOf(kitten.name.toLowerCase()).map((src) => ({
			kind: 'image',
			src,
		}));
		if (kitten.gif) slides.push({ kind: 'gif', ...kitten.gif });
		return { ...kitten, slides };
	}),
}));

const waLink = (text: string) =>
	`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(text)}`;
const mailtoLink = `mailto:${contact.email}?subject=${encodeURIComponent(data.emailSubject)}`;

const iconAttrs = {
	xmlns: 'http://www.w3.org/2000/svg',
	width: '24',
	height: '24',
	viewBox: '0 0 24 24',
	fill: 'none',
	stroke: 'currentColor',
	'stroke-width': '2',
	'stroke-linecap': 'round',
	'stroke-linejoin': 'round',
	'aria-hidden': 'true',
};
---

{/* Browser language detection: first visit of the session to /gatitos/ only */}
<script is:inline define:vars={{ esPath: gatitosPaths.es, enPath: gatitosPaths.en }}>
	try {
		var key = 'gatitos-locale-checked';
		if (!sessionStorage.getItem(key)) {
			sessionStorage.setItem(key, 'true');
			if (window.location.pathname === esPath) {
				var browserLangs = navigator.languages || [navigator.language];
				for (var i = 0; i < browserLangs.length; i++) {
					var code = (browserLangs[i] || '').split('-')[0].toLowerCase();
					if (code === 'es') break;
					if (code === 'en') {
						window.location.replace(enPath);
						break;
					}
				}
			}
		}
	} catch (e) {}
</script>

<div class="mx-auto max-w-5xl px-4 py-6 md:px-6 md:py-10">
	{/* Toolbar: rescue Instagram (left) · language + theme (right) */}
	<div class="flex items-center justify-between gap-3">
		<a
			href={contact.rescueInstagramUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={data.rescueLabel}
			title={data.rescueLabel}
			class="inline-flex min-w-0 items-center gap-2 rounded-lg border border-border bg-card px-2.5 py-2 text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground sm:text-sm"
		>
			<svg class="size-5 shrink-0" {...iconAttrs}><path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M16.5 7.5v.01" /></svg>
			<span class="truncate">{contact.rescueInstagramHandle}</span>
		</a>
		<div class="flex shrink-0 items-center gap-3">
			<nav aria-label={data.languageLabel} class="flex items-center gap-1 text-sm">
				{gatitosLocales.map((code, i) => (
					<>
						{i > 0 && <span class="text-muted-foreground">|</span>}
						{code === lang ? (
							<span class="font-bold text-foreground" aria-current="page">{gatitosLanguageLabels[code]}</span>
						) : (
							<a href={gatitosPaths[code]} class="text-muted-foreground transition-colors hover:text-foreground" hreflang={code}>
								{gatitosLanguageLabels[code]}
							</a>
						)}
					</>
				))}
			</nav>
			<ThemeToggle variant="outline" size="sm" ariaLabel={data.themeLabel} />
		</div>
	</div>

	{/* Header */}
	<header class="mt-6 flex flex-col items-center text-center">
		<div class="flex size-14 items-center justify-center rounded-2xl bg-primary/15 text-primary-accent">
			<svg class="size-8" {...iconAttrs}><path d="M14.7 13.5c-1.1 -2 -1.441 -2.5 -2.7 -2.5c-1.259 0 -1.736 .755 -2.836 2.747c-.942 1.703 -2.846 1.845 -3.321 3.291c-.097 .265 -.145 .677 -.143 .962c0 1.176 .787 2 1.8 2c1.259 0 3 -1 4.5 -1s3.241 1 4.5 1c1.013 0 1.8 -.823 1.8 -2c0 -.285 -.049 -.697 -.146 -.962c-.475 -1.451 -2.512 -1.835 -3.454 -3.538" /><path d="M20.188 8.082a1.039 1.039 0 0 0 -.406 -.082h-.015c-.735 .012 -1.56 .75 -1.993 1.866c-.519 1.335 -.28 2.7 .538 3.052c.129 .055 .267 .082 .406 .082c.739 0 1.575 -.742 2.011 -1.866c.516 -1.335 .273 -2.7 -.54 -3.052l-.001 0" /><path d="M9.474 9c.055 0 .109 0 .163 -.011c.944 -.128 1.533 -1.346 1.32 -2.722c-.203 -1.297 -1.047 -2.267 -1.932 -2.267c-.055 0 -.109 0 -.163 .011c-.944 .128 -1.533 1.346 -1.32 2.722c.204 1.293 1.048 2.267 1.933 2.267" /><path d="M16.456 6.733c.214 -1.376 -.375 -2.594 -1.32 -2.722a1.164 1.164 0 0 0 -.162 -.011c-.885 0 -1.728 .97 -1.93 2.267c-.214 1.376 .375 2.594 1.32 2.722c.054 .007 .108 .011 .162 .011c.885 0 1.73 -.974 1.93 -2.267" /><path d="M5.69 12.918c.816 -.352 1.054 -1.719 .536 -3.052c-.436 -1.124 -1.271 -1.866 -2.009 -1.866c-.14 0 -.277 .027 -.407 .082c-.816 .352 -1.054 1.719 -.536 3.052c.436 1.124 1.271 1.866 2.009 1.866c.14 0 .277 -.027 .407 -.082" /></svg>
		</div>
		<h1 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">{data.heading}</h1>
		<p class="mt-2 max-w-md text-muted-foreground">{data.subtitle}</p>
		<p class="mt-4 inline-flex items-center gap-2 rounded-2xl bg-success/25 px-3.5 py-1.5 text-sm sm:rounded-full">
			<svg class="size-4 shrink-0 text-success-foreground dark:text-success" {...iconAttrs}><path d="M11.46 20.846a12 12 0 0 1 -7.96 -14.846a12 12 0 0 0 8.5 -3a12 12 0 0 0 8.5 3a12 12 0 0 1 -.09 7.06" /><path d="M15 19l2 2l4 -4" /></svg>
			<span set:html={data.testedHtml} />
		</p>
	</header>

	{/* Kitten groups */}
	{groups.map((group) => (
		<section class="mt-12">
			<div class="flex items-baseline justify-between gap-2 border-b border-border pb-2">
				<h2 class="text-xl font-semibold">{group.title}</h2>
				<span class="text-sm text-muted-foreground">{group.age}</span>
			</div>
			<p class="mt-3 mb-5 flex items-start gap-2 rounded-lg bg-muted/60 px-3 py-2 text-xs text-muted-foreground">
				<svg class="mt-px size-3.5 shrink-0" {...iconAttrs}><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 9h.01" /><path d="M11 12h1v4h1" /></svg>
				<span>{group.note}</span>
			</p>
			<div class="flex flex-wrap justify-center gap-6">
				{group.kittens.map((k) => (
					<article class="group w-full overflow-hidden rounded-xl border border-border bg-card shadow-xs transition-all duration-300 ease-out hover:border-primary/60 hover:shadow-xl hover:shadow-primary/15 motion-safe:hover:-translate-y-1 motion-safe:hover:scale-[1.02] sm:w-[calc(50%-0.75rem)] lg:w-[calc((100%-3rem)/3)]">
						{/* Carousel */}
						<div class="relative" data-carousel>
							<div
								class="flex aspect-[3/4] snap-x snap-mandatory overflow-x-auto scroll-smooth bg-muted [scrollbar-width:none] motion-reduce:scroll-auto [&::-webkit-scrollbar]:hidden"
								data-track
							>
								{k.slides.map((slide, i) => (
									<div class="h-full w-full shrink-0 snap-center overflow-hidden">
										{slide.kind === 'gif' ? (
											<img
												src={slide.src}
												alt={data.gifAlt(k.name)}
												width={slide.width}
												height={slide.height}
												loading="lazy"
												decoding="async"
												class="size-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-105"
											/>
										) : (
											<Image
												src={slide.src}
												alt={data.photoAlt(k.name, i + 1)}
												widths={[360, 540, 720]}
												sizes="(min-width: 1024px) 320px, (min-width: 640px) 45vw, 92vw"
												loading="lazy"
												class="size-full object-cover transition-transform duration-500 ease-out motion-safe:group-hover:scale-105"
											/>
										)}
									</div>
								))}
							</div>

							{/* Eye color */}
							<span
								role="img"
								aria-label={data.eyes[k.eye.tone]}
								title={data.eyes[k.eye.tone]}
								class="absolute top-2.5 right-2.5 flex size-8 items-center justify-center rounded-full text-neutral-900 shadow-md ring-2 ring-white/90"
								style={{ backgroundColor: k.eye.hex }}
							>
								<svg class="size-5" {...iconAttrs}><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /><circle cx="12" cy="12" r="2.5" fill="currentColor" /></svg>
							</span>

							{k.slides.length > 1 && (
								<>
									<button
										type="button"
										data-prev
										aria-label={data.prevPhoto}
										class="absolute top-1/2 left-2 flex size-8 -translate-y-1/2 items-center justify-center rounded-full bg-background/70 text-foreground shadow-sm backdrop-blur-sm transition-colors hover:bg-background/90"
									>
										<svg class="size-4" {...iconAttrs}><path d="M15 6l-6 6l6 6" /></svg>
									</button>
									<button
										type="button"
										data-next
										aria-label={data.nextPhoto}
										class="absolute top-1/2 right-2 flex size-8 -translate-y-1/2 items-center justify-center rounded-full bg-background/70 text-foreground shadow-sm backdrop-blur-sm transition-colors hover:bg-background/90"
									>
										<svg class="size-4" {...iconAttrs}><path d="M9 6l6 6l-6 6" /></svg>
									</button>
									<div class="absolute inset-x-0 bottom-2.5 flex justify-center gap-1.5">
										{k.slides.map((_, i) => (
											<button
												type="button"
												data-dot
												aria-label={data.goToPhoto(i + 1, k.slides.length)}
												aria-current={i === 0 ? 'true' : 'false'}
												class="h-1.5 w-1.5 rounded-full bg-white/60 shadow-sm transition-all aria-[current=true]:w-4 aria-[current=true]:bg-white"
											/>
										))}
									</div>
								</>
							)}
						</div>

						{/* Info */}
						<div class="flex items-center justify-between gap-3 p-4">
							<div class="min-w-0">
								<h3 class="text-lg font-semibold">{k.name}</h3>
								<div class="mt-1 flex flex-wrap gap-1.5">
									<Badge variant="outline" size="sm">
										{k.female ? (
											<svg {...iconAttrs}><path d="M7 9a5 5 0 1 0 10 0a5 5 0 1 0 -10 0" /><path d="M12 14v7" /><path d="M9 18h6" /></svg>
										) : (
											<svg {...iconAttrs}><path d="M5 14a5 5 0 1 0 10 0a5 5 0 1 0 -10 0" /><path d="M19 5l-5.4 5.4" /><path d="M19 5h-5" /><path d="M19 5v5" /></svg>
										)}
										{k.female ? data.female : data.male}
									</Badge>
								</div>
							</div>
							<a
								href={waLink(data.waKitten(k.name))}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={data.askAbout(k.name)}
								class="group/btn inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/40 active:scale-95 motion-safe:hover:scale-105"
							>
								<svg class="size-4 transition-transform duration-300 motion-safe:group-hover/btn:-rotate-12 motion-safe:group-hover/btn:scale-110" {...iconAttrs}><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
								{k.female ? data.adoptHer : data.adoptHim}
							</a>
						</div>
					</article>
				))}
			</div>
		</section>
	))}

	{/* Contact */}
	<section class="mt-14 flex flex-col items-center rounded-2xl border border-border bg-muted/50 px-6 py-10 text-center">
		<h2 class="text-2xl font-semibold">{data.ctaTitle}</h2>
		<p class="mt-2 max-w-md text-muted-foreground">{data.ctaText}</p>
		<a
			href={waLink(data.waGeneral)}
			target="_blank"
			rel="noopener noreferrer"
			class="group/btn mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-3 font-medium text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 hover:shadow-xl hover:shadow-primary/40 active:scale-95 motion-safe:hover:scale-105"
		>
			<svg class="size-5 transition-transform duration-300 motion-safe:group-hover/btn:-rotate-12 motion-safe:group-hover/btn:scale-110" {...iconAttrs}><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" /><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" /></svg>
			{data.ctaButton}
		</a>
		<p class="mt-5 max-w-md text-xs text-muted-foreground">
			{data.altContactPrefix} (<a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 transition-colors hover:text-primary-accent">{contact.instagramHandle}</a>) {data.altContactOr} (<a href={mailtoLink} class="underline underline-offset-2 transition-colors hover:text-primary-accent">{contact.email}</a>).
		</p>
	</section>
</div>

<script>
	function initCarousels() {
		for (const root of document.querySelectorAll<HTMLElement>(
			'[data-carousel]',
		)) {
			if (root.dataset.ready) continue;
			root.dataset.ready = 'true';

			const track = root.querySelector<HTMLElement>('[data-track]');
			if (!track) continue;
			const dots = Array.from(
				root.querySelectorAll<HTMLButtonElement>('[data-dot]'),
			);
			const count = track.children.length;
			const current = () => Math.round(track.scrollLeft / track.clientWidth);
			const go = (i: number) => {
				track.scrollTo({ left: ((i + count) % count) * track.clientWidth });
			};

			root
				.querySelector('[data-prev]')
				?.addEventListener('click', () => go(current() - 1));
			root
				.querySelector('[data-next]')
				?.addEventListener('click', () => go(current() + 1));
			dots.forEach((dot, i) => {
				dot.addEventListener('click', () => go(i));
			});
			track.addEventListener(
				'scroll',
				() => {
					const c = current();
					dots.forEach((dot, i) => {
						dot.setAttribute('aria-current', String(i === c));
					});
				},
				{ passive: true },
			);
		}
	}

	document.addEventListener('astro:page-load', initCarousels);
</script>
